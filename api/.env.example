DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tabibdz
DB_USER=tabibdz
DB_PASS=1234
DB_CHARSET=utf8mb4

APP_ENV=local
APP_DEBUG=1
APP_TIMEZONE=Africa/Casablanca

JWT_SECRET=change-this-super-secret-key
JWT_ISSUER=tabibdz-api
JWT_TTL_SECONDS=86400

AUTH_COOKIE_NAME=tabibdz_token
AUTH_COOKIE_SECURE=0
AUTH_COOKIE_SAMESITE=Lax

MAIL_ENABLED=0
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURITY=ssl
MAIL_USERNAME=votre-adresse@gmail.com
MAIL_PASSWORD=votre-mot-de-passe-application
MAIL_FROM_EMAIL=votre-adresse@gmail.com
MAIL_FROM_NAME=TabibDZ
MAIL_REPLY_TO=votre-adresse@gmail.com
MAIL_TIMEOUT=15

GEMINI_API_KEY=replace-with-your-new-gemini-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SYSTEM_CONTEXT=Tu es l'assistant IA de TabibDZ. Reponds en francais clair, avec un ton professionnel. Oriente les utilisateurs sur les rendez-vous, les medecins, les specialites et l'utilisation du site. Pour les symptomes, propose une specialite adaptee sans poser de diagnostic et signale les urgences quand c'est necessaire.
